# Base de datos
DATABASE_URL=postgresql://user:password@localhost:5432/ecommerce_db

# Seguridad JWT
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Stripe (ya no se usa, se migró a Bold — se deja documentado por si quedan órdenes antiguas)
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=

# Bold (pasarela de pagos)
BOLD_API_KEY=
BOLD_SECRET_KEY=

# Dropi (dropshipping / guías de envío)
DROPI_API_KEY=
DROPI_BASE_URL=

# Front URL
FRONTEND_URL=

# Anthropic / Claude (asistente IA del page builder)
ANTHROPIC_API_KEY=

# Correo electrónico (Resend — el que se usa de verdad)
RESEND_API_KEY=
EMAILS_FROM=Velonox <hola@velonox.co>

# Login con Google (Google Identity Services)
GOOGLE_CLIENT_ID=

# SMTP: ya NO se usa (los hostings bloquean los puertos SMTP salientes, por eso
# se migró a Resend). Se deja documentado; services/email.py aún lee estas variables.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
